# Keep the build context small and avoid leaking local files into the image.
node_modules
dist
coverage
# TypeScript incremental cache — MUST be excluded, or a stale copy makes the
# in-container `tsc` skip emitting JS (produces dist without main.js).
*.tsbuildinfo
npm-debug.log
.git
.gitignore
.env
.env.*
!.env.example
docker
.dockerignore
docker-compose.yml
*.md
docs
.vscode
.idea
.DS_Store
