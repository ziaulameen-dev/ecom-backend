# =============================================================================
# Platform configuration. Copy to `.env` (that file is gitignored).
# Used by docker-compose for ${VAR} substitution (--env-file .env).
# =============================================================================

# development | production | test
# NOTE: in `development` TypeORM auto-creates tables from the entities
# (synchronize=on) — needed here because we have no migrations yet. Set this to
# `production` ONLY once you add migrations, or the tables won't exist.
NODE_ENV=development

# Store identity (env-driven so one codebase serves multiple storefronts).
# APP_NAME = display name (emails); STORE_PREFIX = order-reference prefix
# (e.g. SBAZ -> SBAZ-20260808-R6T4NW).
APP_NAME=SBAZWIDE
STORE_PREFIX=SBAZ

# --- JWT trust contract (must be identical for both services) ----------------
JWT_ISSUER=ecom-auth
JWT_AUDIENCE=ecom-api
ACCESS_TOKEN_TTL=15m
# Persistent RSA signing key (base64 of a PKCS8 PEM). When set, tokens survive
# auth-service restarts and the JWKS `kid` stays stable. Leave EMPTY in dev to
# generate an ephemeral key on boot. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64
JWT_PRIVATE_KEY_BASE64=

# --- Refresh tokens ----------------------------------------------------------
# Long-lived, rotating, revocable. POST /auth/refresh swaps a refresh token for
# a new access token without re-doing the OTP flow.
REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=refresh_token

# --- Auth cookie (token delivered to browsers as an HttpOnly cookie) ---------
# Name must match on both services (auth sets it, ecom reads it).
AUTH_COOKIE_NAME=access_token
# lax | strict | none  (none requires Secure/HTTPS)
AUTH_COOKIE_SAMESITE=lax
# Cookie lifetime in ms; keep aligned with ACCESS_TOKEN_TTL (15m = 900000).
AUTH_COOKIE_MAX_AGE_MS=900000

# --- Ports -------------------------------------------------------------------
# Host port for the nginx gateway (the single public entry point).
GATEWAY_PORT=3008
# auth-service container port (also published to the host for debugging).
AUTH_PORT=3009
# ecom-api container port (internal only; reached via nginx).
ECOM_PORT=3008

# --- auth-service database (its OWN Postgres) --------------------------------
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=authpass
AUTH_DB_NAME=authdb

# --- ecom-api database (a SEPARATE Postgres) ---------------------------------
ECOM_DB_USER=ecom
ECOM_DB_PASSWORD=ecompass
ECOM_DB_NAME=ecomdb

# Host ports to reach each Postgres from GUI clients like TablePlus (container
# port is always 5432). Chosen to avoid clashing with other local stacks.
AUTH_DB_HOST_PORT=5442
ECOM_DB_HOST_PORT=5443

# --- Mailpit (local email testing: catches all outgoing mail) ----------------
# Web UI on the host (8025 was taken locally, so we use 8028).
MAILPIT_UI_PORT=8028
# SMTP port on the host (services send mail to mailpit:1025 internally).
MAILPIT_SMTP_PORT=1025
# What services use to reach Mailpit's SMTP over the Docker network.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Auth/TLS are used ONLY when NODE_ENV=production (real SMTP). Dev -> Mailpit.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@ecom.local

# --- CORS --------------------------------------------------------------------
# Comma-separated origin allowlist for browser frontends, shared by both
# services, e.g. "https://shop.example.com,https://admin.example.com". Leave
# empty in dev to reflect the request origin. credentials are always allowed.
CORS_ORIGINS=

# --- Cashfree (India / INR) — payments ---------------------------------------
# Sandbox credentials from the Cashfree dashboard. The secret key stays
# server-side and also verifies webhook signatures. PUBLIC_BASE_URL is the
# publicly reachable base (ngrok in dev) used for Cashfree return/notify URLs;
# the webhook must point at $PUBLIC_BASE_URL/api/payments/webhook.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev
# Flat GST on the subtotal (percent); 0 to disable.
TAX_PERCENT=0

# --- MinIO (object storage for return images) --------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=returns
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- ngrok (dev HTTPS tunnel for Cashfree webhooks) --------------------------
# `npm run tunnel` exposes the gateway publicly at https://$NGROK_DOMAIN.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- Redis (shared session denylist for instant token revocation) ------------
# Host port for debugging; both services reach Redis as redis:6379 internally.
REDIS_HOST_PORT=6381

# --- Rate limiting (auth-service) --------------------------------------------
# Master switch for per-IP rate limiting on the auth endpoints. Leave off in
# dev (so repeated Postman/curl runs don't get 429'd); set to true in prod.
# Limits: POST /auth/otp = 5 / 15 min, POST /auth/verify-otp = 10 / 15 min,
# everything else = 100 / 60s, all per client IP.
RATE_LIMIT_ENABLED=false
