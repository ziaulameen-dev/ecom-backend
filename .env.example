# =============================================================================
# Platform configuration. Copy to `.env` (that file is gitignored).
# Used by docker-compose for ${VAR} substitution (--env-file .env).
# =============================================================================

# development | production | test
# NOTE: in `development` TypeORM auto-creates tables from the entities
# (synchronize=on) — needed here because we have no migrations yet. Set this to
# `production` ONLY once you add migrations, or the tables won't exist.
NODE_ENV=development

# --- JWT trust contract (must be identical for both services) ----------------
JWT_ISSUER=ecom-auth
JWT_AUDIENCE=ecom-api
ACCESS_TOKEN_TTL=15m

# --- Auth cookie (token delivered to browsers as an HttpOnly cookie) ---------
# Name must match on both services (auth sets it, ecom reads it).
AUTH_COOKIE_NAME=access_token
# lax | strict | none  (none requires Secure/HTTPS)
AUTH_COOKIE_SAMESITE=lax
# Cookie lifetime in ms; keep aligned with ACCESS_TOKEN_TTL (15m = 900000).
AUTH_COOKIE_MAX_AGE_MS=900000

# --- Ports -------------------------------------------------------------------
# Host port for the nginx gateway (the single public entry point).
GATEWAY_PORT=3008
# auth-service container port (also published to the host for debugging).
AUTH_PORT=3009
# ecom-api container port (internal only; reached via nginx).
ECOM_PORT=3008

# --- auth-service database (its OWN Postgres) --------------------------------
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=authpass
AUTH_DB_NAME=authdb

# --- ecom-api database (a SEPARATE Postgres) ---------------------------------
ECOM_DB_USER=ecom
ECOM_DB_PASSWORD=ecompass
ECOM_DB_NAME=ecomdb

# --- Mailpit (local email testing: catches all outgoing mail) ----------------
# Web UI on the host (8025 was taken locally, so we use 8028).
MAILPIT_UI_PORT=8028
# SMTP port on the host (services send mail to mailpit:1025 internally).
MAILPIT_SMTP_PORT=1025
# What services use to reach Mailpit's SMTP over the Docker network.
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- Rate limiting (auth-service) --------------------------------------------
# Master switch for per-IP rate limiting on the auth endpoints. Leave off in
# dev (so repeated Postman/curl runs don't get 429'd); set to true in prod.
# Limits: POST /auth/otp = 5 / 15 min, POST /auth/verify-otp = 10 / 15 min,
# everything else = 100 / 60s, all per client IP.
RATE_LIMIT_ENABLED=false
